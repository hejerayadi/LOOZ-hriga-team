# LOOZ Node-RED (farm gateway) — settings.
# 1) Copy this file and name the copy ".env" (same folder). ".env" is never in git.
# 2) Fill in LOOZ_INGEST_URL and LOOZ_GATEWAY_KEY.

# Port of this Node-RED (editor and dashboard): http://127.0.0.1:1881
PORT=1881

# The Edge Function of Supabase that receives the readings:
#   https://<your project>.supabase.co/functions/v1/iot-ingest
LOOZ_INGEST_URL=https://YOUR-PROJECT.supabase.co/functions/v1/iot-ingest

# The SECRET key of the gateway (lgw_ + 64 letters/digits). Get a new one in
# Supabase > SQL Editor:   select public.iot_gateway_new_key('GW-01');
# (the old key stops working at once). Never put it anywhere else.
LOOZ_GATEWAY_KEY=

# The code of this gateway in Supabase (table gateways).
LOOZ_GATEWAY_CODE=GW-01

# Seconds between two batches sent to Supabase: 60 (normal), 20 for a live demo.
LOOZ_BATCH_SECONDS=60

# demo = the simulated clock of the flow (Tunisia time written as UTC: 1 hour
# is removed before sending). real = real sensor boxes with a real clock.
LOOZ_TIME_MODE=demo

# The simulation: summer (default) or frost (the frost night in bloom). The dashboard switch wins once used.
LOOZ_SCENARIO=summer
