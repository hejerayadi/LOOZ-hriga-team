# Settings for the Looz admin API.
# 1) Copy this file and name the copy ".env" (it is ignored by git).
# 2) Fill in the values from Supabase > Project Settings > API (and API Keys).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public key ("anon" or "publishable"). Used with the user's token, so RLS applies.
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SECRET key ("service_role" or "secret"). It bypasses ALL security rules.
# Only here, on the server. Never in the frontend, never in git.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# The only website allowed to call this API (CORS). The same address with
# 127.0.0.1 instead of localhost (or the reverse) is allowed too.
FRONTEND_URL=http://localhost:3000

# true = talk to Supabase over IPv4 only. Use it if every page of the
# dashboard takes about 40 s: the network's IPv6 is broken.
SUPABASE_IPV4_ONLY=false

# "Connexion démo" of the dashboard (PROJECT_STATUS.md section 14): the
# password of the login admin-demo@looz-demo.invalid. Only here, never in
# git, never in the frontend. Empty = no "Connexion démo" button.
# DEMO_ADMIN_PASSWORD=

# Only for "pytest tests_live" (the live test of the dashboard API):
# LIVE_ADMIN_EMAIL=
# LIVE_ADMIN_PASSWORD=

# ---------- The ML worker (python -m ml.worker), PROJECT_STATUS.md section 18 ----------
# Its OWN secret key (not the service_role): SQL Editor > select public.ml_worker_new_key('ML-01');
# (lml_ + 64 letters/digits; a new key stops the old one at once). Never in git, never in the app.
# ML_WORKER_KEY=
# Groq (console.groq.com) for the farmers' explanations (Derja + French). Empty = simple texts of the app.
# GROQ_API_KEY=
# Seconds between two rounds (10). Groq calls per minute at most (6; free tier 8,000 tokens/min).
# ML_POLL_SECONDS=10
# ML_GROQ_PER_MINUTE=6
# The folder of the 2 models (default: AI_modules_time_series/ at the root of the repository).
# ML_MODELS_DIR=
