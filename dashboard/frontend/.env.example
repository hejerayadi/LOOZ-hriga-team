# Settings for the Looz admin dashboard (frontend).
# 1) Copy this file and name the copy ".env.local" (it is ignored by git).
# 2) Fill in the values from Supabase > Project Settings > API.
# These values are PUBLIC (they end up in the browser): NEVER put the
# service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Our FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
