# Supabase keys for the Looz app.
# 1) Copy this file and name the copy ".env" (it is ignored by git).
# 2) Fill in the values from Supabase > Project Settings > API.
# 3) Run the app with:  flutter run --dart-define-from-file=.env
#
# Use the "Publishable" key (or the legacy "anon" key) ONLY. Never the "service_role" key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
