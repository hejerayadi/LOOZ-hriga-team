# =========================================================
# Looz — .gitignore for Flutter (mobile_app) + Node/web (dashboard)
# NOTE: do NOT add a plain "lib/" rule: Flutter code lives in lib/.
# =========================================================

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
*.swp
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/
**/doc/api/
*.g.dart.tmp

# Android
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
xcuserdata/

# ---------- Node / web ----------
node_modules/
dist/
.vite/
.next/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Python (dashboard/backend) ----------
__pycache__/
*.pyc
.venv/
venv/

# ---------- Node-RED of the farm gateway (iot/node-red) ----------
# Runtime files: memory of the flow, editor state, generated secrets.
iot/node-red/context/
iot/node-red/lib/
iot/node-red/.config.*
iot/node-red/.flows*.json.backup
iot/node-red/flows_cred.json
iot/node-red/.flows_cred.json.backup
iot/node-red/.sessions.json

# ---------- Secrets / env ----------
.env
.env.*
!.env.example

# ---------- Logs ----------
*.log
